{
  "name": "ai-placement-analyzer-backend",
  "version": "1.0.0",
  "description": "Backend API for AI Placement Analyzer (Node.js ES Modules)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test:unit": "vitest run tests/unit",
